  "intra_scene_depth": {
    "status": "user-provided-art-direction-not-produced-assets",
    "principle": "同一幅画面或面片内的场景，按前景、主体、中景与背景等分别绘制，使用适量的真实前后距离形成一个立体小场景。",
    "hierarchy": [
      "世界与场景组之间的深度",
      "同一幅画面内部的深度层"
    ],
    "example_layers_far_to_near": [
      {
        "id": "far-view",
        "content": "窗外天色、城市或远处灯光"
      },
      {
        "id": "background",
        "content": "墙、门窗与墙面装饰"
      },
      {
        "id": "midground",
        "content": "桌椅、书架与设备"
      },
      {
        "id": "subject",
        "content": "插画人物或主要物件"
      },
      {
        "id": "foreground",
        "content": "桌角、栏杆、招牌与局部装饰"
      }
    ],
    "composition": "共享父场景、参考构图、尺度与锚点，沿局部深度轴安排各层；以参考视点对齐并检查偏侧观察。",
    "spacing": "随构图尺度、观看范围和阅读需求确定，不设置统一层间距或固定层数。",
    "occlusion_fill": "补画被前景遮住的背景和主体，边缘为允许的观察范围留出余量。",
    "cropping": "可裁去无用透明边，但保留画布定位、锚点与偏移；裁切或图集不得改变层间对齐。",
    "text_and_controls": "正文与界面控件以可读的紧密浅层组织，场景插画的内部承担更明显深度。",
    "near_edges": "近处可绕看的部分按需要加侧面、背面或简单体块。",
    "actor_scope": "插画内人物可拆层，场景中的真实 NPC 仍使用骨骼演员。",
    "counting": "一个分层场景记为一个母素材，层导出、动画帧和补画工作量单列。"
  },
  "spatial_rules": [
    "主要面片保持所属场景组内的朝向，场景组可按演出时间整体运动，图层不逐个追随头部。",
    "小型装饰可使用朝向观众的方式；所有主要页面不统一贴头旋转。",
    "界面框、底色、内容、选区和提示可拆为少量层，关键合拢和移动可辨。",
    "同一幅插画、漫画格或房间画面继续拆为独立绘制的深度层，统一父场景与构图，补齐遮挡区域。",
    "手边屏幕有机壳，纸页有背面与纸叠，入口有门框；近处接触物用简单实体。",
    "近处保留一个主要动作，中景安排同类活动，远景以轮廓、招牌和小循环形成规模。",
    "层间使用实际三维距离，避免重叠闪烁；单眼合成图不冒充立体场景。",
    "普通页面优先用不透明或适合裁切的方式，透明边缘按需求单独组织。",
    "长段无界时不画全局房间或场地外框，活动片段可在不同距离、方向和高度分布；内外互换用分层与复制布景另做空间原型。"
  ],
